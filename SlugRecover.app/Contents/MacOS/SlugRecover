#!/bin/bash
# Opens the SlugRecover launcher in a Terminal window.
# The .app lives in the SlugRecover folder, next to the launcher.
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
LAUNCHER="$DIR/Start SlugRecover.command"

if [ ! -f "$LAUNCHER" ]; then
    # The .app was moved out of its folder — tell the person kindly
    osascript -e 'display dialog "SlugRecover could not find its files.\n\nPlease keep the SlugRecover app inside the SlugRecover folder. To put it on your Desktop or Dock, drag it there WITHOUT moving it out of the folder (the Dock keeps it in place), or right-click it and choose Make Alias." buttons {"OK"} with icon caution with title "SlugRecover"'
    exit 1
fi

chmod +x "$LAUNCHER" 2>/dev/null
open -a Terminal "$LAUNCHER"
